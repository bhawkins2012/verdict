{
  "name": "Verdict Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",

  // Services: Postgres + Redis via Docker Compose
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",

  // VS Code extensions auto-installed
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "Prisma.prisma",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "humao.rest-client",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[python]": {
          "editor.defaultFormatter": "ms-python.python"
        },
        "typescript.tsdk": "frontend/node_modules/typescript/lib",
        "tailwindCSS.includeLanguages": { "typescript": "html", "typescriptreact": "html" },
        "sqltools.connections": [
          {
            "name": "Verdict DB",
            "driver": "PostgreSQL",
            "host": "postgres",
            "port": 5432,
            "database": "verdict_db",
            "username": "verdict_user",
            "password": "verdict_dev_password"
          }
        ]
      }
    }
  },

  // Port forwarding — opens automatically in Codespaces
  "forwardPorts": [5173, 3001, 8000, 5432, 6379],
  "portsAttributes": {
    "5173": { "label": "Frontend", "onAutoForward": "openPreview" },
    "3001": { "label": "Backend API", "onAutoForward": "notify" },
    "8000": { "label": "ML Service", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "6379": { "label": "Redis", "onAutoForward": "silent" }
  },

  // Runs once after the container is created
  "onCreateCommand": "bash .devcontainer/on-create.sh",

  // Runs every time the Codespace starts (after hibernate)
  "postStartCommand": "bash .devcontainer/post-start.sh"
}

# Dev defaults. DB credentials match docker-compose.yml; all services are on localhost.
# Replace every secret below before deploying anywhere real.

# Database
DATABASE_URL="postgresql://verdict_user:verdict_dev_password@localhost:5432/verdict_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ML Service
ML_SERVICE_URL="http://localhost:8000"

# Optional: Email for nudges (Resend, Sendgrid, etc.)
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=your_email_api_key
# EMAIL_FROM=nudge@verdict.app

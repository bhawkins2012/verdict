# Dev defaults. DB credentials match docker-compose.yml; all services are on localhost.
# Replace every secret below before deploying anywhere real.

# Database
DATABASE_URL="postgresql://verdict_user:verdict_dev_password@localhost:5432/verdict_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
NODE_ENV=development
# Browser-facing frontend URL: links in emails and the CORS origin. In a GitHub Codespace, leave it on
# localhost (or unset): the backend derives https://$CODESPACE_NAME-<port>.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN.
# FRONTEND_PORT (default 5173) is the Vite port used for that, and by Vite itself.
FRONTEND_URL="http://localhost:5173"

# Reverse proxy hops to trust for X-Forwarded-For (Codespaces proxy, load balancer, ...). Default 1.
# Express uses this for req.ip, and so for per-client rate limiting; too low and every user shares one
# bucket, too high and clients can spoof their IP. Use 0 when clients connect directly. A list such as
# "loopback, 10.0.0.0/8" is also accepted. "true" and match-everything subnets are refused at startup.
TRUST_PROXY=1

# Requests per 15 minutes per client on /api (default 200).
# RATE_LIMIT_MAX=200

# ML Service
ML_SERVICE_URL="http://localhost:8000"

# ── Nudges (docs/adr-nudges.md; CLAUDE.md "Nudges") ─────────────────────────────────────────────
# Email provider: "console" (dry run, default: logs and keeps an in-memory outbox, sends nothing)
# or "resend". Resend needs RESEND_API_KEY (a secret: put it here locally or in a Codespaces secret,
# never in git), NUDGE_FROM_EMAIL on a domain verified in Resend, and NUDGE_POSTAL_ADDRESS.
NUDGE_EMAIL_PROVIDER=console
# RESEND_API_KEY=
# NUDGE_FROM_EMAIL="Verdict <reminders@your-domain.example>"
# NUDGE_POSTAL_ADDRESS="Your Company, 1 Example Street, City, Country"

# HMAC key for unsubscribe links. Dev value only: production must set its own (>= 32 chars) and it
# must differ from the JWT secrets. Changing it invalidates every unsubscribe link already sent.
UNSUBSCRIBE_SECRET="dev-only-unsubscribe-secret-change-me-in-production-0123"

# Real-provider sends only go to users with a verified email (none are, until email verification
# ships), so this keeps production email effectively off. Dry-run sends are not affected.
NUDGE_REQUIRE_VERIFIED_EMAIL=true
# NUDGE_DAILY_CAP=1           # emails per user per local day
# NUDGE_MAX_ATTEMPTS=5        # provider attempts before a nudge is dead-lettered (FAILED)
# NUDGES_ENABLED=true         # set false to disable the worker and reconciler


# ── Value lever generation (docs/adr-levers.md; CLAUDE.md "Value levers") ───────────────────────────
# "dry_run" (default): fixture candidates, no API call. "live": calls the Anthropic API and needs
# ANTHROPIC_API_KEY (a secret: put it here locally or in a Codespaces secret, never in git); startup
# fails if live mode has no key.
LEVER_GEN_MODE=dry_run
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5      # default; the model the Claude docs recommend as the starting point
# LEVER_GEN_MAX_TOKENS=16000           # output cap per run (thinking included)
# LEVER_GEN_DAILY_LIMIT=10             # live runs per rolling 24 h, all admins together (0 disables live runs)

// Verdict — Prisma Schema
// PostgreSQL + pgvector

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────
// USERS & DEMOGRAPHICS
// ─────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  displayName   String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  emailVerified Boolean  @default(false)

  // Nudge preferences (docs/adr-nudges.md D5). Email is opt-in: off until the user turns it on.
  emailNudgesEnabled        Boolean   @default(false)
  emailNudgesConsentAt      DateTime?
  timezone                  String    @default("UTC") // IANA name, e.g. "Europe/Berlin"
  nudgeSendHour             Int       @default(9) // 0-23, local to `timezone`
  // The user declined the post-first-review email prompt; it is never shown again (profile settings still work).
  nudgePromptDismissedAt    DateTime?
  // First time the user turned email reminders on (any path); never cleared, so an opt-out (profile or
  // unsubscribe link) does not bring the opt-in prompt back.
  emailNudgesFirstEnabledAt DateTime?
  // When the address was last verified (docs/adr-email-verification.md); emailVerified stays the gate.
  emailVerifiedAt           DateTime?

  // Admin rights (docs/adr-levers.md D1). Read from the database on every admin request, never from the JWT.
  role UserRole @default(USER)

  demographics       UserDemographics?
  reviewThreads      ReviewThread[]
  refreshTokens      RefreshToken[]
  nudges             Nudge[]
  verificationTokens EmailVerificationToken[]

  createdNodes         TaxonomyNode[]      @relation("NodeCreatedBy")
  publishedNodes       TaxonomyNode[]      @relation("NodePublishedBy")
  approvedExplainers   TaxonomyNode[]      @relation("NodeExplainerApprovedBy")
  createdLeverDefs     LeverDefinition[]   @relation("LeverDefinitionCreatedBy")
  editedLeverDefs      LeverDefinition[]   @relation("LeverDefinitionEditedBy")
  approvedLevers       NodeLever[]         @relation("NodeLeverApprovedBy")
  retiredLevers        NodeLever[]         @relation("NodeLeverRetiredBy")
  leverRuns            LeverCandidateRun[]
  generationRuns       GenerationRun[]
  surveyImports        SurveyImport[]
  reviewedProducts     Product[]           @relation("ProductReviewedBy")
  reviewedLeverValues  ProductLeverValue[] @relation("ValueReviewedBy")
  editedLeverValues    ProductLeverValue[] @relation("ValueEditedBy")
  verifiedBrandDomains BrandDomain[]

  @@map("users")
}

model UserDemographics {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ageRange       AgeRange?
  genderIdentity String?
  region         String? // ISO 3166-1 alpha-2 country + subdivision
  incomeBracket  IncomeBracket?
  lifestyleTags  String[] // ["outdoor", "tech-early-adopter", "budget-conscious", ...]
  householdSize  Int?
  hasChildren    Boolean?
  educationLevel EducationLevel?

  updatedAt DateTime @updatedAt

  @@map("user_demographics")
}

// ─────────────────────────────────────────
// PRODUCTS & EXPERIENCES
// ─────────────────────────────────────────

model Product {
  id          String        @id @default(cuid())
  name        String
  brand       String?
  // Kept equal to the node's slug on every write: the ML service and older filters read this string.
  // nodeId is the real link (docs/adr-generation-run.md D2); removing this column is in the backlog.
  category    String
  // A decision node (trigger in SQL); null = unplaced, never listed.
  nodeId      String?
  node        TaxonomyNode? @relation(fields: [nodeId], references: [id])
  subcategory String?
  description String?
  imageUrl    String?
  websiteUrl  String?
  priceTier   PriceTier?
  attributes  Json          @default("{}") // flexible KV for category-specific attrs

  // External IDs for aggregation
  amazonAsin    String? @unique
  googlePlaceId String? @unique
  yelpId        String? @unique
  steamAppId    String? @unique
  goodreadsId   String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // user id who added it

  reviewThreads     ReviewThread[]
  aggregatedReviews AggregatedReview[]
  leverValues       ProductLeverValue[]
  publishedValues   PublishedLeverValue[]

  // Catalog (docs/adr-generation-run.md D2, section 5 A1). Discovered products start PROPOSED and are
  // approved automatically when every check passes, or go to NEEDS_ATTENTION with the failed check.
  catalogStatus     CatalogStatus         @default(APPROVED)
  approvedVia       ApprovedVia?
  attentionCheck    String?
  attentionReason   String?
  manufacturerUrl   String?
  discoveredByRunId String?
  discoveredByRun   GenerationRun?        @relation(fields: [discoveredByRunId], references: [id], onDelete: SetNull)
  reviewedById      String?
  reviewedBy        User?                 @relation("ProductReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  // Written only by the publish transaction: shown in its node's public list.
  listed            Boolean               @default(false)
  isDryRun          Boolean               @default(false)
  alsoListedIn      ProductAlsoListedIn[]
  extractionItems   ExtractionItem[]

  // Computed fields updated by background jobs
  avgRatingInitial  Float?
  avgRatingLongterm Float?
  driftScoreAvg     Float? // negative = products that disappoint over time
  totalReviewCount  Int    @default(0)

  @@index([category])
  @@index([nodeId])
  @@index([brand])
  @@map("products")
}

// ─────────────────────────────────────────
// REVIEW THREADS (groups all stages for one user+product)
// ─────────────────────────────────────────

model ReviewThread {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Optional, user-supplied. Nudge due dates are anchored on purchasedAt ?? startedAt (ADR D3).
  purchasedAt DateTime?

  // Computed drift: (latestRating - initialRating), null if only 1 review
  driftScore      Float?
  // Stages completed so far
  stagesCompleted ReviewStage[]

  reviews Review[]
  nudges  Nudge[]

  @@unique([userId, productId])
  @@map("review_threads")
}

// ─────────────────────────────────────────
// REVIEWS (individual stage captures)
// ─────────────────────────────────────────

model Review {
  id       String       @id @default(cuid())
  threadId String
  thread   ReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  stage      ReviewStage
  capturedAt DateTime     @default(now())
  source     ReviewSource @default(NATIVE)

  // Scores (1-10 scale for granularity)
  scoreOverall      Int // required
  scoreValue        Int?
  scoreQuality      Int?
  scoreLongevity    Int? // "has it held up?"
  scoreExpectations Int? // "met expectations?"

  bodyText String?
  pros     String[]
  cons     String[]

  wouldStillBuy  Boolean?
  wouldRecommend Boolean?

  // NLP-computed fields (populated by ML service)
  sentimentScore Float? // -1.0 to 1.0
  keyTopics      String[]
  summaryAuto    String? // auto-generated summary

  // For imported reviews
  externalId     String?
  externalUrl    String?
  externalAuthor String?

  @@unique([threadId, stage])
  @@index([threadId])
  @@index([stage])
  @@map("reviews")
}

// ─────────────────────────────────────────
// AGGREGATED REVIEWS (imported from external sources)
// ─────────────────────────────────────────

model AggregatedReview {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  source           AggregationSource
  externalId       String
  authorName       String?
  rating           Float // normalized to 1-10
  bodyText         String?
  reviewDate       DateTime?
  verifiedPurchase Boolean           @default(false)

  // NLP enrichment
  sentimentScore Float?
  keyTopics      String[]
  pros           String[]
  cons           String[]

  importedAt DateTime @default(now())

  @@unique([source, externalId])
  @@map("aggregated_reviews")
}

// ─────────────────────────────────────────
// NUDGE SCHEDULER
// ─────────────────────────────────────────

model Nudge {
  id       String       @id @default(cuid())
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId String
  thread   ReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  targetStage  ReviewStage
  scheduledFor DateTime // due date, anchored on the thread's purchase/start date
  sendAt       DateTime // when to email: due date rounded to the user's send hour, snooze, retry backoff, cap deferral
  sentAt       DateTime?
  completedAt  DateTime?
  status       NudgeStatus     @default(PENDING)
  channel      NudgeChannel? // how the user was notified once due: EMAIL or IN_APP only
  endedReason  NudgeEndReason?

  // Delivery bookkeeping (ADR D2, D7)
  attempts          Int       @default(0) // provider calls made
  lastAttemptAt     DateTime?
  lastError         String?
  claimedAt         DateTime? // set when a worker wins the send-claim
  providerMessageId String?

  snoozedUntil DateTime?
  snoozeCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One nudge per thread and stage; state changes update this row.
  @@unique([threadId, targetStage])
  @@index([userId, status])
  @@index([status, sendAt])
  @@map("nudges")
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum ReviewStage {
  INITIAL
  ONE_WEEK
  TWO_WEEKS
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
  TWO_YEARS
  CUSTOM
}

enum ReviewSource {
  NATIVE
  IMPORTED
}

enum AggregationSource {
  AMAZON
  GOOGLE
  YELP
  STEAM
  GOODREADS
  TRIPADVISOR
  MANUAL
}

enum PriceTier {
  BUDGET
  MID_RANGE
  PREMIUM
  LUXURY
}

enum AgeRange {
  AGE_18_24
  AGE_25_34
  AGE_35_44
  AGE_45_54
  AGE_55_64
  AGE_65_PLUS
}

enum IncomeBracket {
  UNDER_30K
  RANGE_30_50K
  RANGE_50_75K
  RANGE_75_100K
  RANGE_100_150K
  OVER_150K
}

enum EducationLevel {
  HIGH_SCHOOL
  SOME_COLLEGE
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
}

enum NudgeStatus {
  PENDING // scheduled; waiting for sendAt
  SENDING // a worker holds the send-claim
  SENT // user notified (by email or in-app only, see channel)
  COMPLETED // review for this stage submitted
  SKIPPED // user skipped this stage
  CANCELLED // superseded by a later stage
  FAILED // email dead-lettered after retries or a permanent provider error; still shown in-app
}

enum NudgeChannel {
  EMAIL
  IN_APP
}

enum NudgeEndReason {
  REVIEW_SUBMITTED
  SUPERSEDED
  USER_SKIPPED
}

// Email verification links (docs/adr-email-verification.md D1). The link carries the id (selector) and a
// 32-byte random verifier; only sha256(verifier) is stored. Single use, 24 h, superseded by newer tokens.
model EmailVerificationToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String // the (normalized) address this token verifies; must still be the user's address
  tokenHash    String // hex sha256(verifier); never the verifier itself
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  supersededAt DateTime?

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

enum EmailRateKind {
  VERIFICATION_EMAIL // key: sha256(normalized address)
  SIGNUP_ATTEMPT_EMAIL // key: sha256(normalized address)
  EMAIL_CHANGE_ATTEMPT // key: user id
}

// Rate-limit events stored in the database, so limits hold across processes and restarts and work for
// addresses that have no user (docs/adr-email-verification.md D4).
model EmailRateEvent {
  id        String        @id @default(cuid())
  kind      EmailRateKind
  key       String
  createdAt DateTime      @default(now())
  /// When the provider accepted the email. Address slots whose email was never sent (the process died
  /// before sending) stop counting after a few minutes, so a crash cannot block resend for an hour.
  sentAt    DateTime?

  @@index([kind, key, createdAt])
  @@map("email_rate_events")
}

// ─────────────────────────────────────────
// CATEGORIES & VALUE LEVERS (docs/adr-levers.md)
// ─────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

// ─────────────────────────────────────────
// TAXONOMY, LEVERS AND THE GENERATION RUN (docs/adr-generation-run.md)
// ─────────────────────────────────────────

enum NodeKind {
  NAVIGATION // children, an explainer; no levers or products
  DECISION // a leaf: five published levers and a product list
}

enum LeverType {
  MEASUREMENT
  CATEGORY
  COMPATIBILITY_LIST
  BOOLEAN
}

// How a MEASUREMENT lever's value is recorded. DIMENSIONS: length, width and height in inches plus an
// optional one-hand-fold flag; the filterable number is the volume computed from them (cu ft).
enum LeverInputFormat {
  SINGLE
  DIMENSIONS
}

enum LeverStatus {
  CANDIDATE
  APPROVED // approved = published: always exactly 0 or 5 per node (deferred trigger in SQL)
  RETIRED
}

enum LeverOrigin {
  GENERATED
  ADMIN
  REFERENCE // the Phase A stroller set, an input to the Full-size strollers run
}

enum LeverRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum LeverRunMode {
  LIVE
  DRY_RUN
}

enum CatalogStatus {
  PROPOSED
  APPROVED
  NEEDS_ATTENTION
  REJECTED
}

enum ApprovedVia {
  AUTO
  ADMIN
}

enum ValueStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

enum ValueOrigin {
  EXTRACTED // from a fetched manufacturer page or PDF, quote checked verbatim
  MANUAL // entered by an admin with a URL and a pasted quote (section 5 A4)
  PHASE_A // migrated Phase A value without evidence; can never pass the gate
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum AcceptMode {
  SINGLE
  BULK
}

enum GenerationRunKind {
  NODE
  EXPLAINER
}

enum GenerationRunStatus {
  ACTIVE
  READY_FOR_REVIEW
  STALLED
  FAILED
  CANCELLED
  PUBLISHED
}

enum RunStage {
  PLACE
  LEVERS
  DISCOVER
  VERIFY
  EXTRACT
  EXPLAIN
}

enum StageStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  STALLED
}

enum ItemStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  WAITING // the brand's domain is waiting for an admin to confirm it
}

enum CallStatus {
  RESERVED
  DONE
  FAILED
}

enum FetchOutcome {
  OK
  ROBOTS_DISALLOWED
  NOT_ALLOWED
  HTTP_ERROR
  BLOCKED
  UNSUPPORTED_TYPE
  TOO_LARGE
  NETWORK
  SCANNED_PDF
}

enum FetchedKind {
  PAGE
  PDF
  HOMEPAGE
}

enum BrandDomainStatus {
  VERIFIED
  PENDING_CONFIRMATION
  REJECTED
}

enum BrandVerifiedVia {
  AUTOMATIC
  ADMIN
}

// The Phase A `categories` table, renamed (ids kept).
model TaxonomyNode {
  id             String         @id @default(cuid())
  slug           String         @unique // lower(btrim(...)); also the value of Product.category
  name           String
  kind           NodeKind       @default(DECISION)
  // Primary parent: drives breadcrumbs. Navigation nodes only (trigger); no cycles (trigger).
  parentId       String?
  parent         TaxonomyNode?  @relation("NodeParent", fields: [parentId], references: [id], onDelete: Restrict)
  children       TaxonomyNode[] @relation("NodeParent")
  position       Int            @default(0)
  searchTerms    String[]
  // Set on Car seats; inherited by every descendant (all their levers are safety-flagged).
  safetyCritical Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  createdBy      User?          @relation("NodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Navigation nodes: how the children differ, written by an EXPLAINER run, public once approved.
  explainer             String?
  explainerChildLines   Json? // { "<child slug>": "one line" }
  explainerApprovedAt   DateTime?
  explainerApprovedById String?
  explainerApprovedBy   User?     @relation("NodeExplainerApprovedBy", fields: [explainerApprovedById], references: [id], onDelete: SetNull)

  // Decision nodes: set by the atomic publish. Null: hidden from browse.
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("NodePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  secondaryParents   NodeSecondaryParent[] @relation("SecondaryChild")
  secondaryChildren  NodeSecondaryParent[] @relation("SecondaryParent")
  products           Product[]
  alsoListedProducts ProductAlsoListedIn[]
  levers             NodeLever[]
  runs               GenerationRun[]
  legacyRuns         LeverCandidateRun[]
  surveyImports      SurveyImport[]
  publishedValues    PublishedLeverValue[]

  @@index([parentId])
  @@map("taxonomy_nodes")
}

// "Also listed in": a node shown under another navigation node too. Covered by the cycle trigger.
model NodeSecondaryParent {
  nodeId      String
  node        TaxonomyNode @relation("SecondaryChild", fields: [nodeId], references: [id], onDelete: Cascade)
  parentId    String
  parent      TaxonomyNode @relation("SecondaryParent", fields: [parentId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime     @default(now())

  @@id([nodeId, parentId])
  @@index([parentId])
  @@map("node_secondary_parents")
}

// A lever defined once and shared by sibling nodes, so the same attribute is measured the same way.
model LeverDefinition {
  id            String           @id @default(cuid())
  name          String
  nameKey       String           @unique // normalized name: lower case, single spaces
  type          LeverType
  inputFormat   LeverInputFormat @default(SINGLE)
  unit          String? // canonical unit, MEASUREMENT only (CHECK in SQL)
  explanation   String
  relatedNeeds  String[]
  allowedValues String[] // CATEGORY only
  safetyFlag    Boolean          @default(false)
  minValue      Float? // plausibility range in the canonical unit (optional)
  maxValue      Float?
  origin        LeverOrigin
  createdById   String?
  createdBy     User?            @relation("LeverDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  editedById    String?
  editedBy      User?            @relation("LeverDefinitionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt      DateTime?

  nodeLevers      NodeLever[]
  values          ProductLeverValue[]
  publishedValues PublishedLeverValue[]

  @@map("lever_definitions")
}

// A definition's place on one decision node.
model NodeLever {
  id           String          @id @default(cuid())
  nodeId       String
  node         TaxonomyNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  definitionId String
  definition   LeverDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  status       LeverStatus     @default(CANDIDATE)
  position     Int? // 1-5, set exactly when APPROVED (CHECK in SQL)
  // definition.safetyFlag, or the node is safety-critical (trigger keeps it true there)
  safety       Boolean         @default(false)
  origin       LeverOrigin
  runId        String?
  run          GenerationRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  note         String? // the model's note, e.g. why a reference lever should be dropped
  // Snapshot of the definition taken at publish; public pages read this.
  published    Json?
  approvedById String?
  approvedBy   User?           @relation("NodeLeverApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  retiredById  String?
  retiredBy    User?           @relation("NodeLeverRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)
  retiredAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([nodeId, definitionId])
  @@unique([nodeId, position])
  @@index([nodeId, status])
  @@map("node_levers")
}

model ProductAlsoListedIn {
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  nodeId    String
  node      TaxonomyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([productId, nodeId])
  @@index([nodeId])
  @@map("product_also_listed_in")
}

// Phase A lever runs, kept read-only as history (docs/adr-generation-run.md D3).
model LeverCandidateRun {
  id          String       @id @default(cuid())
  categoryId  String
  category    TaxonomyNode @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  mode        LeverRunMode
  status      LeverRunStatus @default(RUNNING)
  model       String
  servedModel String?
  input       Json
  output      Json?
  error       String?

  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  costUsd         Decimal? @db.Decimal(10, 6)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([mode, createdAt])
  @@index([categoryId, createdAt])
  @@map("lever_candidate_runs")
}

model SurveyImport {
  id           String       @id @default(cuid())
  nodeId       String
  node         TaxonomyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  filename     String
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime     @default(now())
  rowCount     Int

  rankings SurveyRanking[]

  @@index([nodeId, uploadedAt])
  @@map("survey_imports")
}

model SurveyRanking {
  id              String       @id @default(cuid())
  importId        String
  import          SurveyImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  leverName       String
  rank            Int
  respondentCount Int

  @@index([importId])
  @@map("survey_rankings")
}

model ProductLeverValue {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String
  definition   LeverDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  status ValueStatus @default(PROPOSED)
  origin ValueOrigin

  isUnknown   Boolean  @default(false)
  valueNumber Float? // MEASUREMENT, canonical unit (DIMENSIONS: the computed volume in cu ft)
  unit        String?
  valueText   String? // CATEGORY: one of the definition's allowedValues
  valueBool   Boolean? // BOOLEAN; DIMENSIONS: one-hand fold
  valueList   String[] // COMPATIBILITY_LIST
  dimLengthIn Float?
  dimWidthIn  Float?
  dimHeightIn Float?
  detail      String?

  // Evidence (docs/adr-generation-run.md D7): as the page states it, before unit conversion.
  statedValue          String?
  statedUnit           String?
  evidenceQuote        String?
  sourceUrl            String?
  confidence           Confidence?
  unknownReason        String?
  // Manual values whose source could not be fetched (section 5 A4).
  adminAttested        Boolean       @default(false)
  attestedFetchOutcome FetchOutcome?

  runId       String?
  run         GenerationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  extractedAt DateTime?

  reviewedById  String?
  reviewedBy    User?       @relation("ValueReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  acceptMode    AcceptMode?
  editedById    String?
  editedBy      User?       @relation("ValueEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt      DateTime?
  originalValue Json? // the extracted value before the first admin edit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, definitionId])
  @@index([definitionId])
  @@index([runId])
  @@map("product_lever_values")
}

// What the public sees: a copy of each accepted value of the five levers, written only by the publish
// transaction (docs/adr-generation-run.md D10). Edits, re-extraction and review after a publish change
// product_lever_values, never this table, so nothing reaches the public until the next publish.
model PublishedLeverValue {
  id           String          @id @default(cuid())
  nodeId       String
  node         TaxonomyNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String
  definition   LeverDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  isUnknown     Boolean  @default(false)
  valueNumber   Float?
  unit          String?
  valueText     String?
  valueBool     Boolean?
  valueList     String[]
  dimLengthIn   Float?
  dimWidthIn    Float?
  dimHeightIn   Float?
  detail        String?
  evidenceQuote String?
  sourceUrl     String?
  adminAttested Boolean  @default(false)
  publishedAt   DateTime

  @@unique([productId, definitionId])
  @@index([nodeId, definitionId])
  @@map("published_lever_values")
}

model GenerationRun {
  id          String              @id @default(cuid())
  nodeId      String
  node        TaxonomyNode        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  kind        GenerationRunKind
  mode        LeverRunMode
  status      GenerationRunStatus @default(ACTIVE)
  createdById String?
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  notes       String?
  model       String // requested model, or "dry-run"
  capUsd      Decimal             @db.Decimal(10, 4)
  estimateUsd Decimal?            @db.Decimal(10, 4)
  warning     String? // e.g. "Only 12 products found (target 15-20)"
  error       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  finishedAt  DateTime?
  // Set when the run first reached READY_FOR_REVIEW (the admin notice is sent once).
  readyAt     DateTime?

  stages   GenerationRunStage[]
  calls    GenerationCall[]
  items    ExtractionItem[]
  levers   NodeLever[]
  products Product[]
  values   ProductLeverValue[]
  pages    FetchedPage[]

  @@index([nodeId, createdAt])
  @@index([status])
  @@map("generation_runs")
}

model GenerationRunStage {
  id          String        @id @default(cuid())
  runId       String
  run         GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage       RunStage
  status      StageStatus   @default(PENDING)
  attempts    Int           @default(0)
  startedAt   DateTime?
  heartbeatAt DateTime?
  finishedAt  DateTime?
  error       String?
  output      Json?

  @@unique([runId, stage])
  @@index([status, heartbeatAt])
  @@map("generation_run_stages")
}

// The cost ledger: one row per API call, reserved before the call (worst case), settled after.
model GenerationCall {
  id              String        @id @default(cuid())
  runId           String
  run             GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage           RunStage
  productId       String?
  model           String
  servedModel     String?
  status          CallStatus    @default(RESERVED)
  reservedUsd     Decimal       @db.Decimal(10, 6)
  costUsd         Decimal?      @db.Decimal(10, 6)
  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  webSearches     Int?
  error           String?
  createdAt       DateTime      @default(now())
  finishedAt      DateTime?

  @@index([createdAt])
  @@index([runId])
  @@map("generation_calls")
}

model ExtractionItem {
  id           String        @id @default(cuid())
  runId        String
  run          GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  status       ItemStatus    @default(PENDING)
  fetchOutcome FetchOutcome?
  httpStatus   Int?
  fetchedAt    DateTime?
  attempts     Int           @default(0)
  // Each auto-approval check: { brandDomain, fetch, modelNamed, nodeFit, duplicate } with pass/fail + reason.
  checks       Json?
  documents    Json? // [{ url, kind, outcome, chars }]
  error        String?
  claimedAt    DateTime?
  heartbeatAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([runId, productId])
  @@index([runId, status])
  @@map("extraction_items")
}

// Extracted text of a fetched page or PDF. Deleted 24 h after fetching; every read filters expiresAt.
model FetchedPage {
  id          String         @id @default(cuid())
  url         String
  kind        FetchedKind
  runId       String?
  run         GenerationRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  productId   String?
  text        String
  contentHash String
  fetchedAt   DateTime       @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@index([url])
  @@map("fetched_pages")
}

// The allow-list: verified manufacturer hosts per brand (section 5 A1).
model BrandDomain {
  id           String            @id @default(cuid())
  brandKey     String // normalized brand: lower case letters and digits
  brand        String
  host         String            @unique // lower case, no leading "www."
  status       BrandDomainStatus
  verifiedVia  BrandVerifiedVia?
  verifiedById String?
  verifiedBy   User?             @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  checkResult  Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([brandKey])
  @@map("brand_domains")
}

// Per-host fetch state: the rate limiter's clock, the robots.txt cache, and a pause after a block.
model FetchHost {
  host            String    @id // lower case, no leading "www."
  lastFetchAt     DateTime?
  robotsTxt       String?
  robotsStatus    String? // "ok", "allow_all" (4xx), "disallow_all" (5xx / network)
  robotsFetchedAt DateTime?
  crawlDelaySec   Int?
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("fetch_hosts")
}

// Verdict — Prisma Schema
// PostgreSQL + pgvector

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────
// USERS & DEMOGRAPHICS
// ─────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  displayName   String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  emailVerified Boolean  @default(false)

  // Nudge preferences (docs/adr-nudges.md D5). Email is opt-in: off until the user turns it on.
  emailNudgesEnabled        Boolean   @default(false)
  emailNudgesConsentAt      DateTime?
  timezone                  String    @default("UTC") // IANA name, e.g. "Europe/Berlin"
  nudgeSendHour             Int       @default(9) // 0-23, local to `timezone`
  // The user declined the post-first-review email prompt; it is never shown again (profile settings still work).
  nudgePromptDismissedAt    DateTime?
  // First time the user turned email reminders on (any path); never cleared, so an opt-out (profile or
  // unsubscribe link) does not bring the opt-in prompt back.
  emailNudgesFirstEnabledAt DateTime?
  // When the address was last verified (docs/adr-email-verification.md); emailVerified stays the gate.
  emailVerifiedAt           DateTime?

  // Admin rights (docs/adr-levers.md D1). Read from the database on every admin request, never from the JWT.
  role UserRole @default(USER)

  demographics       UserDemographics?
  reviewThreads      ReviewThread[]
  refreshTokens      RefreshToken[]
  nudges             Nudge[]
  verificationTokens EmailVerificationToken[]

  createdCategories   Category[]          @relation("CategoryCreatedBy")
  publishedCategories Category[]          @relation("CategoryLeversPublishedBy")
  approvedLevers      ValueLever[]        @relation("LeverApprovedBy")
  retiredLevers       ValueLever[]        @relation("LeverRetiredBy")
  editedLevers        ValueLever[]        @relation("LeverEditedBy")
  leverRuns           LeverCandidateRun[]
  surveyImports       SurveyImport[]
  recordedLeverValues ProductLeverValue[]

  @@map("users")
}

model UserDemographics {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ageRange       AgeRange?
  genderIdentity String?
  region         String? // ISO 3166-1 alpha-2 country + subdivision
  incomeBracket  IncomeBracket?
  lifestyleTags  String[] // ["outdoor", "tech-early-adopter", "budget-conscious", ...]
  householdSize  Int?
  hasChildren    Boolean?
  educationLevel EducationLevel?

  updatedAt DateTime @updatedAt

  @@map("user_demographics")
}

// ─────────────────────────────────────────
// PRODUCTS & EXPERIENCES
// ─────────────────────────────────────────

model Product {
  id          String     @id @default(cuid())
  name        String
  brand       String?
  // Kept equal to the category's slug on every write: the ML service and older filters read this string.
  // categoryId is the real link (docs/adr-levers.md D2); removing this column is in the backlog.
  category    String
  categoryId  String?
  categoryRef Category?  @relation(fields: [categoryId], references: [id])
  subcategory String?
  description String?
  imageUrl    String?
  websiteUrl  String?
  priceTier   PriceTier?
  attributes  Json       @default("{}") // flexible KV for category-specific attrs

  // External IDs for aggregation
  amazonAsin    String? @unique
  googlePlaceId String? @unique
  yelpId        String? @unique
  steamAppId    String? @unique
  goodreadsId   String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // user id who added it

  reviewThreads     ReviewThread[]
  aggregatedReviews AggregatedReview[]
  leverValues       ProductLeverValue[]

  // Computed fields updated by background jobs
  avgRatingInitial  Float?
  avgRatingLongterm Float?
  driftScoreAvg     Float? // negative = products that disappoint over time
  totalReviewCount  Int    @default(0)

  @@index([category])
  @@index([categoryId])
  @@index([brand])
  @@map("products")
}

// ─────────────────────────────────────────
// REVIEW THREADS (groups all stages for one user+product)
// ─────────────────────────────────────────

model ReviewThread {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Optional, user-supplied. Nudge due dates are anchored on purchasedAt ?? startedAt (ADR D3).
  purchasedAt DateTime?

  // Computed drift: (latestRating - initialRating), null if only 1 review
  driftScore      Float?
  // Stages completed so far
  stagesCompleted ReviewStage[]

  reviews Review[]
  nudges  Nudge[]

  @@unique([userId, productId])
  @@map("review_threads")
}

// ─────────────────────────────────────────
// REVIEWS (individual stage captures)
// ─────────────────────────────────────────

model Review {
  id       String       @id @default(cuid())
  threadId String
  thread   ReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  stage      ReviewStage
  capturedAt DateTime     @default(now())
  source     ReviewSource @default(NATIVE)

  // Scores (1-10 scale for granularity)
  scoreOverall      Int // required
  scoreValue        Int?
  scoreQuality      Int?
  scoreLongevity    Int? // "has it held up?"
  scoreExpectations Int? // "met expectations?"

  bodyText String?
  pros     String[]
  cons     String[]

  wouldStillBuy  Boolean?
  wouldRecommend Boolean?

  // NLP-computed fields (populated by ML service)
  sentimentScore Float? // -1.0 to 1.0
  keyTopics      String[]
  summaryAuto    String? // auto-generated summary

  // For imported reviews
  externalId     String?
  externalUrl    String?
  externalAuthor String?

  @@unique([threadId, stage])
  @@index([threadId])
  @@index([stage])
  @@map("reviews")
}

// ─────────────────────────────────────────
// AGGREGATED REVIEWS (imported from external sources)
// ─────────────────────────────────────────

model AggregatedReview {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  source           AggregationSource
  externalId       String
  authorName       String?
  rating           Float // normalized to 1-10
  bodyText         String?
  reviewDate       DateTime?
  verifiedPurchase Boolean           @default(false)

  // NLP enrichment
  sentimentScore Float?
  keyTopics      String[]
  pros           String[]
  cons           String[]

  importedAt DateTime @default(now())

  @@unique([source, externalId])
  @@map("aggregated_reviews")
}

// ─────────────────────────────────────────
// NUDGE SCHEDULER
// ─────────────────────────────────────────

model Nudge {
  id       String       @id @default(cuid())
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId String
  thread   ReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  targetStage  ReviewStage
  scheduledFor DateTime // due date, anchored on the thread's purchase/start date
  sendAt       DateTime // when to email: due date rounded to the user's send hour, snooze, retry backoff, cap deferral
  sentAt       DateTime?
  completedAt  DateTime?
  status       NudgeStatus     @default(PENDING)
  channel      NudgeChannel? // how the user was notified once due: EMAIL or IN_APP only
  endedReason  NudgeEndReason?

  // Delivery bookkeeping (ADR D2, D7)
  attempts          Int       @default(0) // provider calls made
  lastAttemptAt     DateTime?
  lastError         String?
  claimedAt         DateTime? // set when a worker wins the send-claim
  providerMessageId String?

  snoozedUntil DateTime?
  snoozeCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One nudge per thread and stage; state changes update this row.
  @@unique([threadId, targetStage])
  @@index([userId, status])
  @@index([status, sendAt])
  @@map("nudges")
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum ReviewStage {
  INITIAL
  ONE_WEEK
  TWO_WEEKS
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
  TWO_YEARS
  CUSTOM
}

enum ReviewSource {
  NATIVE
  IMPORTED
}

enum AggregationSource {
  AMAZON
  GOOGLE
  YELP
  STEAM
  GOODREADS
  TRIPADVISOR
  MANUAL
}

enum PriceTier {
  BUDGET
  MID_RANGE
  PREMIUM
  LUXURY
}

enum AgeRange {
  AGE_18_24
  AGE_25_34
  AGE_35_44
  AGE_45_54
  AGE_55_64
  AGE_65_PLUS
}

enum IncomeBracket {
  UNDER_30K
  RANGE_30_50K
  RANGE_50_75K
  RANGE_75_100K
  RANGE_100_150K
  OVER_150K
}

enum EducationLevel {
  HIGH_SCHOOL
  SOME_COLLEGE
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
}

enum NudgeStatus {
  PENDING // scheduled; waiting for sendAt
  SENDING // a worker holds the send-claim
  SENT // user notified (by email or in-app only, see channel)
  COMPLETED // review for this stage submitted
  SKIPPED // user skipped this stage
  CANCELLED // superseded by a later stage
  FAILED // email dead-lettered after retries or a permanent provider error; still shown in-app
}

enum NudgeChannel {
  EMAIL
  IN_APP
}

enum NudgeEndReason {
  REVIEW_SUBMITTED
  SUPERSEDED
  USER_SKIPPED
}

// Email verification links (docs/adr-email-verification.md D1). The link carries the id (selector) and a
// 32-byte random verifier; only sha256(verifier) is stored. Single use, 24 h, superseded by newer tokens.
model EmailVerificationToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String // the (normalized) address this token verifies; must still be the user's address
  tokenHash    String // hex sha256(verifier); never the verifier itself
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  supersededAt DateTime?

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

enum EmailRateKind {
  VERIFICATION_EMAIL // key: sha256(normalized address)
  SIGNUP_ATTEMPT_EMAIL // key: sha256(normalized address)
  EMAIL_CHANGE_ATTEMPT // key: user id
}

// Rate-limit events stored in the database, so limits hold across processes and restarts and work for
// addresses that have no user (docs/adr-email-verification.md D4).
model EmailRateEvent {
  id        String        @id @default(cuid())
  kind      EmailRateKind
  key       String
  createdAt DateTime      @default(now())
  /// When the provider accepted the email. Address slots whose email was never sent (the process died
  /// before sending) stop counting after a few minutes, so a crash cannot block resend for an hour.
  sentAt    DateTime?

  @@index([kind, key, createdAt])
  @@map("email_rate_events")
}

// ─────────────────────────────────────────
// CATEGORIES & VALUE LEVERS (docs/adr-levers.md)
// ─────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum LeverType {
  MEASUREMENT
  CATEGORY
  COMPATIBILITY_LIST
  BOOLEAN
}

// How a MEASUREMENT lever's value is recorded. DIMENSIONS: folded length, width and height in inches plus
// an optional one-hand-fold flag; the filterable number is the volume computed from them (cu ft), never
// entered by hand.
enum LeverInputFormat {
  SINGLE
  DIMENSIONS
}

enum LeverStatus {
  CANDIDATE
  APPROVED // approved = published: always exactly 0 or 5 per category (deferred trigger in SQL)
  RETIRED
}

enum LeverOrigin {
  GENERATED
  ADMIN
}

enum LeverRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum LeverRunMode {
  LIVE
  DRY_RUN
}

enum ValueSourceType {
  URL
  ADMIN_ENTERED
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique // lower(btrim(...)); also the value of Product.category
  name        String
  searchTerms String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Set when a set of five levers is published. Null: the category is hidden from browse.
  leversPublishedAt   DateTime?
  leversPublishedById String?
  leversPublishedBy   User?     @relation("CategoryLeversPublishedBy", fields: [leversPublishedById], references: [id], onDelete: SetNull)

  products      Product[]
  levers        ValueLever[]
  runs          LeverCandidateRun[]
  surveyImports SurveyImport[]

  @@map("categories")
}

model ValueLever {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name          String
  type          LeverType
  inputFormat   LeverInputFormat @default(SINGLE)
  unit          String? // MEASUREMENT only (CHECK in SQL)
  explanation   String
  relatedNeeds  String[]
  allowedValues String[] // CATEGORY only; required (>= 2) to publish

  status   LeverStatus        @default(CANDIDATE)
  position Int? // 1-5, set exactly when APPROVED (CHECK in SQL)
  origin   LeverOrigin
  runId    String?
  run      LeverCandidateRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User?     @relation("LeverApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  retiredById  String?
  retiredBy    User?     @relation("LeverRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)
  retiredAt    DateTime?
  editedById   String?
  editedBy     User?     @relation("LeverEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  editedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ProductLeverValue[]

  // NULL positions (candidates, retired) never collide in Postgres.
  @@unique([categoryId, position])
  @@index([categoryId, status])
  @@map("value_levers")
}

model LeverCandidateRun {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  mode        LeverRunMode
  status      LeverRunStatus @default(RUNNING)
  model       String // requested model, or "dry-run"
  servedModel String? // model named in the API response
  input       Json // prompt version, category, notes, max tokens, effort
  output      Json? // validated candidates; null on failure
  error       String? // short reason on failure; never a key or a raw response body

  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  costUsd         Decimal? @db.Decimal(10, 6)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  levers ValueLever[]

  @@index([mode, createdAt])
  @@index([categoryId, createdAt])
  @@map("lever_candidate_runs")
}

model SurveyImport {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  filename     String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())
  rowCount     Int

  rankings SurveyRanking[]

  @@index([categoryId, uploadedAt])
  @@map("survey_imports")
}

model SurveyRanking {
  id              String       @id @default(cuid())
  importId        String
  import          SurveyImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  leverName       String
  rank            Int
  respondentCount Int

  @@index([importId])
  @@map("survey_rankings")
}

model ProductLeverValue {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  leverId   String
  lever     ValueLever @relation(fields: [leverId], references: [id], onDelete: Cascade)

  isUnknown   Boolean  @default(false)
  valueNumber Float? // MEASUREMENT (for DIMENSIONS: the computed volume in cu ft)
  unit        String?
  valueText   String? // CATEGORY: one of the lever's allowedValues
  valueBool   Boolean? // BOOLEAN; DIMENSIONS: one-hand fold
  valueList   String[] // COMPATIBILITY_LIST
  dimLengthIn Float? // DIMENSIONS only
  dimWidthIn  Float?
  dimHeightIn Float?
  detail      String?

  sourceType  ValueSourceType
  sourceUrl   String? // required exactly when sourceType = URL (CHECK in SQL)
  sourceLabel String?
  isSample    Boolean         @default(false)

  recordedById String? // set by every API path; null only for seed data outside dev/test, or after the user was deleted
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt   DateTime @default(now())

  @@unique([productId, leverId])
  @@index([leverId])
  @@map("product_lever_values")
}
